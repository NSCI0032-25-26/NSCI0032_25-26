&control
    calculation='scf',
    prefix='cu',
    outdir='./tmp',
    pseudo_dir='/home/jovyan/espresso/pseudo'
    verbosity='high'
/
&system
    ibrav=2, celldm(1)=6.63,
    nat=1, ntyp=1,
    ecutwfc=80,
    occupations='smearing',
    smearing='mv',
    degauss=0.02
/
&electrons
    conv_thr=1.0d-1
/
ATOMIC_SPECIES
 Cu 63.546 Cu.pbe-dn-kjpaw_psl.1.0.0.UPF
ATOMIC_POSITIONS crystal
 Cu 0.0 0.0 0.0
K_POINTS automatic
 6 6 6 1 1 1
