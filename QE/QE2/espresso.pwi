&CONTROL
   calculation      = 'scf'
   verbosity        = 'high'
   tstress          = .true.
   tprnfor          = .true.
   pseudo_dir       = './pseudos'
/
&SYSTEM
   ecutwfc          = 50
   ecutrho          = 400
   occupations      = 'smearing'
   degauss          = 0.02
   smearing         = 'mp'
   ntyp             = 1
   nat              = 1
   ibrav            = 0
/
&ELECTRONS
   conv_thr         = 1e-06
/
&IONS
/
&CELL
/
&FCP
/
&RISM
/
ATOMIC_SPECIES
Cu 63.546 Cu.pbe-dn-kjpaw_psl.1.0.0.UPF

K_POINTS automatic
8 8 8  0 0 0

CELL_PARAMETERS angstrom
0.00000000000000 1.99100000000000 1.99100000000000
1.99100000000000 0.00000000000000 1.99100000000000
1.99100000000000 1.99100000000000 0.00000000000000

ATOMIC_POSITIONS angstrom
Cu 0.0000000000 0.0000000000 0.0000000000  

