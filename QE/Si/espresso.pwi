&CONTROL
   calculation      = 'scf'
   restart_mode     = 'from_scratch'
   tstress          = .true.
   tprnfor          = .true.
   outdir           = './'
   prefix           = 'si_scf'
   pseudo_dir       = './pseudos'
/
&SYSTEM
   ecutwfc          = 50
   ecutrho          = 200
   occupations      = 'smearing'
   degauss          = 0.01
   smearing         = 'gaussian'
   input_dft        = 'PBE'
   ntyp             = 1
   nat              = 2
   ibrav            = 0
/
&ELECTRONS
   conv_thr         = 1e-08
/
&IONS
/
&CELL
/
&FCP
/
&RISM
/
ATOMIC_SPECIES
Si 28.085 Si.vbc.UPF

K_POINTS automatic
6 6 6  0 0 0

CELL_PARAMETERS angstrom
0.00000000000000 2.70500000000000 2.70500000000000
2.70500000000000 0.00000000000000 2.70500000000000
2.70500000000000 2.70500000000000 0.00000000000000

ATOMIC_POSITIONS angstrom
Si 0.0000000000 0.0000000000 0.0000000000  
Si 1.3525000000 1.3525000000 1.3525000000  

